# Copy this file to config.env and fill it in.  No spaces inside values.

# Your image (built automatically by GitHub):  ghcr.io/<your-github-username-lowercase>/comfy-h3:latest
DOCKER_IMAGE=ghcr.io/yourgithubname/comfy-h3:latest

# Login for the ComfyUI web page (letters/numbers only, no spaces)
COMFY_USER=admin
COMFY_PASSWORD=change-me-to-something-long

# --- What to rent ---
GPU=RTX_5090
MAX_PRICE=0.80            # max $/hr per GPU (all-in, incl. storage)
MIN_INET_MBIT=1000        # advertised download speed filter (Mbit/s)
MIN_RAM_GB=64             # system RAM (text encoder gets offloaded here on a 32 GB card)
DISK_GB=180               # ~110 GB models + ~20 GB image + outputs
MAX_BW_COST_PER_TB=5      # skip hosts charging more than $5/TB download (each boot pulls ~47 GB)
MIN_RELIABILITY=0.98

# --- Dud detection ---
MIN_MBPS=60               # real measured download speed required, MB/s (60 MB/s ~ 500 Mbit/s)
MAX_ATTEMPTS=6            # how many hosts to try per GPU before giving up

# --- Safety net ---
IDLE_MINUTES=45           # destroys itself after this long with no jobs AND no ComfyUI tab open (0 = never)

# --- Quick-add custom nodes without rebuilding (installed at every boot, adds ~30s) ---
# Comma-separated GitHub links, no spaces. Move them to custom_nodes.txt to make them permanent.
# EXTRA_NODES=https://github.com/someone/some-node,https://github.com/other/other-node

# --- Optional ---
# HF_TOKEN=hf_xxx         # only for gated/private Hugging Face files
# CIVITAI_TOKEN=xxx       # CivitAI API key, for LoRA downloads from civitai.com
# EXTRA_MODELS=loras|https://civitai.com/api/download/models/123456|my_lora.safetensors
# Automatic output backup to Backblaze B2 (see README). Any RCLONE_* line is passed to the instance.
# RCLONE_REMOTE=b2:yourname-h3-outputs/h3
# RCLONE_CONFIG_B2_TYPE=b2
# RCLONE_CONFIG_B2_ACCOUNT=your-keyID
# RCLONE_CONFIG_B2_KEY=your-applicationKey
